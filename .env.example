# ------------------------------------------------------------------
# DocuMind AI environment variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local. Only names and placeholders belong here.
# ------------------------------------------------------------------

# --- Supabase (Project Settings -> API) ---
# Safe for the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" key, or the newer "publishable" key. Do NOT use the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Site URL (used for documentation/links only) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Gemini (https://aistudio.google.com/apikey) ---
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Limits and RAG tuning (all optional) ---
NEXT_PUBLIC_MAX_UPLOAD_MB=20
MAX_DOCUMENTS_PER_USER=200
CHAT_LIMIT_PER_MINUTE=10
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.5
